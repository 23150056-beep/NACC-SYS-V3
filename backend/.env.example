# NACC SYS V3 backend — environment template.
#
#   cp .env.example .env
#
# Every value here is a DEVELOPMENT default. Cloud deploys set these through
# the platform's environment/secret store instead of a file — see
# docs/CLOUD-DEPLOYMENT.md for the production values.

# ---- Core ----------------------------------------------------------------
# Required when DJANGO_DEBUG=False; the app refuses to boot without it.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Browser origins allowed to call the API, and to submit forms to it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Database ------------------------------------------------------------
# Cloud platforms provide DATABASE_URL; set it and the DB_* block is ignored.
# DATABASE_URL=postgres://user:password@host:5432/nacc_v3
# DB_SSL_REQUIRE=true       # managed Postgres reached over the public internet
# DB_CONN_MAX_AGE=600

# On-premises / legacy path. Leave DB_ENGINE unset for the SQLite fallback,
# which is what the test suite and a fresh checkout use.
# DB_ENGINE=postgres
# DB_NAME=nacc_v3
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---- Uploaded files (reports, consent scans, child photos) ---------------
FILE_UPLOAD_MAX_MB=15

# Container filesystems are ephemeral: anything written to MEDIA_ROOT is gone
# on the next deploy. Any cloud deploy must set USE_S3=true (or mount a
# persistent volume) or it WILL lose uploaded case files.
# The bucket must be private — files are served only through authenticated
# API endpoints, never from a public URL.
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=nacc-v3-media
# AWS_S3_REGION_NAME=ap-southeast-1
# AWS_S3_ENDPOINT_URL=          # blank for AWS S3; set for R2 / B2 / Supabase
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_URL_EXPIRY=300         # seconds a signed URL stays valid
# MEDIA_ROOT=                   # local-disk fallback; defaults to backend/media

# ---- HTTPS ---------------------------------------------------------------
# Applied only when DJANGO_DEBUG=False. Set to False behind a proxy that does
# not forward X-Forwarded-Proto, or the app will redirect in a loop.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# ---- AI layer (optional — the system is fully functional with AI off) -----
# Two providers, selected by an administrator in Settings → AI Assistance.
#
# 1. On-premises Ollama. Loopback-only unless the agency knowingly hosts it
#    elsewhere on its own network.
# ALLOW_REMOTE_OLLAMA=false
#
# 2. Hosted API, for cloud deploys with no GPU host. The key stays in the
#    server environment: it is never written to the database and never
#    returned by the API. With no key set, the hosted provider reports itself
#    unavailable and every AI feature simply switches off.
# AI_HOSTED_API_KEY=
# AI_HOSTED_MAX_TOKENS=8000
# AI_HOSTED_TIMEOUT=120         # must stay below GUNICORN_TIMEOUT (180)

# ---- Runtime (container only) --------------------------------------------
# PORT=8000
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=180
# RUN_SEED=false                # true on first deploy: roles + default admin
