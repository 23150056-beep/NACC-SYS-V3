# NACC SYS V3 frontend — environment template.
#
#   cp .env.example .env
#
# Vite inlines VITE_* variables at BUILD time, not run time. Changing this
# value means rebuilding the bundle — there is no runtime override, and one
# build artifact belongs to exactly one environment.

# Where the Django API lives. Must include the /api suffix.
#   local dev      http://localhost:8000/api
#   docker compose http://localhost:8000/api
#   cloud          https://nacc-v3-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
